                  <span className="absolute -bottom-10 -right-2 text-[80px] text-[#ff0000]/10 font-serif leading-none select-none rotate-180 hidden lg:block">"</span>
                </div>
              </div>
              
              {/* Call to Action Container */}
              <div className="w-full lg:max-w-xl max-w-[350px] md:max-w-[450px] shrink-0 flex flex-col items-center p-6 md:p-10 bg-black/40 rounded-3xl border border-[#ff0000]/15 backdrop-blur-md shadow-[inset_0_0_20px_rgba(255,0,0,0.05)] mx-auto">
                <div className="w-12 h-12 md:w-16 md:h-16 rounded-full bg-[#ff0000]/10 flex items-center justify-center mb-4 md:mb-6 text-[#ff0000] group-hover:scale-110 transition-transform duration-500">
                  <HeartHandshake size={28} strokeWidth={1.5} className="md:w-8 md:h-8 w-6 h-6" />
                </div>
                <h4 className={`text-[#ff0000] ${language === 'en' ? 'text-[24px] md:text-[30px]' : (language === 'ur' ? 'text-[45px] font-["Georgia"]' : (language === 'hi' ? 'text-[37px]' : (language === 'hi' ? '' : 'text-lg md:text-xl')))} mb-2 md:mb-4 font-bold ${language === 'ur' || language === 'hi' ? '' : t.fontClassSerif} text-center tracking-wider`}>{(lt as any).bePartOfMission || "Be Part of the Mission"}</h4>
                <p className={`text-gray-400 text-center ${language === 'en' ? 'text-[16px] md:text-[20px] max-w-[350px]' : (language === 'ur' ? 'text-[20px] leading-[41.5714px] max-w-[350px]' : (language === 'hi' ? 'text-[20px] font-["Asar"] max-w-[250px]' : 'text-xs md:text-sm max-w-[250px]'))} mb-6 md:mb-8 ${t.fontClassSans}`}>{(lt as any).contributionHelps || "Your contribution helps us feed the souls in need."}</p>
                
                <button 
                  onClick={() => navigate('/donate')}
                  className="group/btn relative w-full px-4 sm:px-6 md:px-8 h-[50px] md:h-[56px] flex items-center justify-center bg-[#ff0000] text-white overflow-hidden rounded-full shadow-[0_0_20px_rgba(255,0,0,0.4)] hover:shadow-[0_0_35px_rgba(255,0,0,0.6)] transition-all duration-300 hover:-translate-y-1"
                >
                  <div className="absolute inset-0 bg-white/20 translate-y-full group-hover/btn:translate-y-0 transition-transform duration-500 ease-out rounded-full"></div>
                  <span className={`relative z-10 uppercase tracking-[0.1em] sm:tracking-[0.2em] ${language === 'en' ? 'text-[15px] sm:text-[17px] md:text-[19px]' : (language === 'ur' ? 'text-[30px] font-["Noto_Naskh_Arabic"]' : (language === 'hi' ? 'text-[26px] font-["Arial"]' : 'text-[10px] sm:text-[12px] md:text-[14px]'))} font-bold ${language === 'ur' || language === 'hi' ? '' : t.fontClassSans} whitespace-normal text-center`}>
                    {lt.cta}
                  </span>
                </button>
              </div>
              
            </div>
          </div>
        </motion.div>
      </div>

      {/* Lightbox Overlay */}
      <AnimatePresence>
        {selectedImage && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            onClick={() => setSelectedImage(null)}
            className="fixed inset-0 z-50 flex items-center justify-center bg-black/98 p-4 md:p-12 cursor-pointer backdrop-blur-xl"
          >
            <button
              onClick={() => setSelectedImage(null)}
              className="absolute top-8 right-8 text-white/50 hover:text-[#ff0000] transition-colors z-50 p-2"
            >
              <X className="w-10 h-10" />
            </button>
            <motion.img
              initial={{ scale: 0.9, opacity: 0 }}
              animate={{ scale: 1, opacity: 1 }}
              exit={{ scale: 0.9, opacity: 0 }}
              transition={{ type: "spring", damping: 25, stiffness: 300 }}
              src={selectedImage}
              alt="Enlarged view"
              className="max-w-full max-h-[90vh] object-contain shadow-[0_0_50px_rgba(255,0,0,0.2)] border border-[#330000]"
              onClick={(e) => e.stopPropagation()}
            />
          </motion.div>
        )}
      </AnimatePresence>
    </section>
  );
}
